# Production Environment Variables
REACT_APP_ENV=production
REACT_APP_API_URL=https://om-backend-gi1a.onrender.com
REACT_APP_SITE_URL=https://blacklocust.in

# Firebase Authentication (Google login + Phone OTP)
REACT_APP_FIREBASE_API_KEY=AIzaSyDLsLz5NJxDz6udqD8PSYR1w6uUHZP1BoI
REACT_APP_FIREBASE_AUTH_DOMAIN=blacklocust-auth.firebaseapp.com
